/-
  Extraction: emit the kernel-checked decode table as SystemVerilog and JSON.

  This is the Open6502 adaptation of CktLean's `#synthesizeVerilog` step: the
  Lean definitions are the source of truth, and the files written here are
  derived artifacts.  `scripts/check_rtl_sync.py` then checks the emitted table
  against the opcode lists in `rtl/cpu/open6502_cpu.sv`, so a drift between the
  proof model and the RTL fails CI instead of silently invalidating the proofs.
-/
import Open6502.Decode

open Open6502

/-- Mode index used by both the JSON and the SystemVerilog output. -/
def modeId : Mode → Nat
  | .imp => 0 | .acc => 1 | .imm => 2 | .zp => 3 | .zpx => 4 | .zpy => 5
  | .abs => 6 | .absx => 7 | .absy => 8 | .ind => 9 | .indx => 10
  | .indy => 11 | .rel => 12

def modeSv : Mode → String
  | .imp => "MODE_IMP" | .acc => "MODE_ACC" | .imm => "MODE_IMM"
  | .zp => "MODE_ZP" | .zpx => "MODE_ZPX" | .zpy => "MODE_ZPY"
  | .abs => "MODE_ABS" | .absx => "MODE_ABSX" | .absy => "MODE_ABSY"
  | .ind => "MODE_IND" | .indx => "MODE_INDX" | .indy => "MODE_INDY"
  | .rel => "MODE_REL"

/-- Canonical opcode order, used for the numeric `instr` encoding. -/
def opList : List Op :=
  [.adc, .and_, .asl, .bcc, .bcs, .beq, .bit, .bmi, .bne, .bpl, .brk, .bvc, .bvs,
   .clc, .cld, .cli, .clv, .cmp, .cpx, .cpy, .dec, .dex, .dey, .eor, .inc, .inx,
   .iny, .jmp, .jsr, .lda, .ldx, .ldy, .lsr, .nop, .ora, .pha, .php, .pla, .plp,
   .rol, .ror, .rti, .rts, .sbc, .sec, .sed, .sei, .sta, .stx, .sty, .tax, .tay,
   .tsx, .txa, .txs, .tya]

def opId (op : Op) : Nat := opList.idxOf op

/-- JavaScript-free mode name for the JSON output. -/
def modeStr : Mode → String
  | .imp => "imp" | .acc => "acc" | .imm => "imm" | .zp => "zp" | .zpx => "zpx"
  | .zpy => "zpy" | .abs => "abs" | .absx => "absx" | .absy => "absy"
  | .ind => "ind" | .indx => "indx" | .indy => "indy" | .rel => "rel"

def hex2 (n : Nat) : String :=
  let digits := "0123456789ABCDEF".toList
  let hi := digits[n / 16]!
  let lo := digits[n % 16]!
  s!"{hi}{lo}"

def svCase (e : Entry) : String :=
  s!"      8'h{hex2 e.opcode.toNat}: begin mode = {modeSv e.mode}; cycles = 8'd{e.cycles}; instr = INSTR_{e.op.mnemonic}; end"

def jsonEntry (e : Entry) : String :=
  s!"  \{\"opcode\": {e.opcode.toNat}, \"mnemonic\": \"{e.op.mnemonic}\", \"mode\": \"{modeStr e.mode}\", \"mode_id\": {modeId e.mode}, \"cycles\": {e.cycles}}"

def renderSv : String :=
  let cases := "\n".intercalate (officialTable.map svCase)
  s!"// Auto-generated by `lake exe open6502-extract` from Open6502/Opcodes.lean.
// Do not edit by hand.
`default_nettype none
module open6502_decode_table (
  input  logic [7:0] opcode,
  output logic [3:0] mode,
  output logic [7:0] cycles,
  output logic [7:0] instr
);
  localparam logic [7:0] INSTR_ADC = 8'd0, INSTR_AND = 8'd1, INSTR_ASL = 8'd2,
                         INSTR_BCC = 8'd3, INSTR_BCS = 8'd4, INSTR_BEQ = 8'd5,
                         INSTR_BIT = 8'd6, INSTR_BMI = 8'd7, INSTR_BNE = 8'd8,
                         INSTR_BPL = 8'd9, INSTR_BRK = 8'd10, INSTR_BVC = 8'd11,
                         INSTR_BVS = 8'd12, INSTR_CLC = 8'd13, INSTR_CLD = 8'd14,
                         INSTR_CLI = 8'd15, INSTR_CLV = 8'd16, INSTR_CMP = 8'd17,
                         INSTR_CPX = 8'd18, INSTR_CPY = 8'd19, INSTR_DEC = 8'd20,
                         INSTR_DEX = 8'd21, INSTR_DEY = 8'd22, INSTR_EOR = 8'd23,
                         INSTR_INC = 8'd24, INSTR_INX = 8'd25, INSTR_INY = 8'd26,
                         INSTR_JMP = 8'd27, INSTR_JSR = 8'd28, INSTR_LDA = 8'd29,
                         INSTR_LDX = 8'd30, INSTR_LDY = 8'd31, INSTR_LSR = 8'd32,
                         INSTR_NOP = 8'd33, INSTR_ORA = 8'd34, INSTR_PHA = 8'd35,
                         INSTR_PHP = 8'd36, INSTR_PLA = 8'd37, INSTR_PLP = 8'd38,
                         INSTR_ROL = 8'd39, INSTR_ROR = 8'd40, INSTR_RTI = 8'd41,
                         INSTR_RTS = 8'd42, INSTR_SBC = 8'd43, INSTR_SEC = 8'd44,
                         INSTR_SED = 8'd45, INSTR_SEI = 8'd46, INSTR_STA = 8'd47,
                         INSTR_STX = 8'd48, INSTR_STY = 8'd49, INSTR_TAX = 8'd50,
                         INSTR_TAY = 8'd51, INSTR_TSX = 8'd52, INSTR_TXA = 8'd53,
                         INSTR_TXS = 8'd54, INSTR_TYA = 8'd55;
  localparam logic [3:0] MODE_IMP = 4'd0, MODE_ACC = 4'd1, MODE_IMM = 4'd2,
                         MODE_ZP = 4'd3, MODE_ZPX = 4'd4, MODE_ZPY = 4'd5,
                         MODE_ABS = 4'd6, MODE_ABSX = 4'd7, MODE_ABSY = 4'd8,
                         MODE_IND = 4'd9, MODE_INDX = 4'd10, MODE_INDY = 4'd11,
                         MODE_REL = 4'd12;
  always_comb begin
    mode = MODE_IMP;
    cycles = 8'd2;
    instr = 8'd0;
    case (opcode)
{cases}
      default: begin mode = MODE_IMP; cycles = 8'd2; instr = 8'd0; end
    endcase
  end
endmodule
`default_nettype wire
"

def renderJson : String :=
  let entries := ",\n".intercalate (officialTable.map jsonEntry)
  s!"\{\n  \"official_count\": {officialTable.length},\n  \"opcodes\": [\n{entries}\n  ]\n}\n"

def main (args : List String) : IO Unit := do
  let outDir := args.headD "build"
  IO.FS.createDirAll outDir
  IO.FS.writeFile (outDir ++ "/open6502_decode.sv") renderSv
  IO.FS.writeFile (outDir ++ "/decode.json") renderJson
  IO.println s!"wrote {outDir}/open6502_decode.sv and {outDir}/decode.json ({officialTable.length} opcodes)"

